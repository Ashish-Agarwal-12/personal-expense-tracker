# Copy this file to .env for local development (`npm run dev`). Never commit .env.

# MongoDB Atlas connection string. Leave empty locally to use a temporary in-memory database.
MONGODB_URI=
MONGODB_DB=expense_tracker

# Password you type to log in to the website (at least 8 characters).
APP_PASSWORD=

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
